# ── LLM Provider ─────────────────────────────────────────────────────────────
# Which LLM backend to use: openai | gemini | local
LLM_PROVIDER=openai

# Model name passed to the chosen provider
#   openai  → gpt-4o, gpt-4o-mini, o3-mini, …
#   gemini  → gemini-2.0-flash, gemini-1.5-pro, …
#   local   → depends on what you have loaded (e.g. llama3, mistral)
LLM_MODEL=gpt-4o-mini

# Only used when LLM_PROVIDER=local
# Point at any OpenAI-compatible endpoint:
#   Ollama:    http://localhost:11434/v1
#   LM Studio: http://localhost:1234/v1
LLM_BASE_URL=http://localhost:11434/v1

# ── LLM API Keys ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...
# Local providers typically don't need a real key, but the SDK may require a non-empty value
LOCAL_API_KEY=local

# ── Embedding Provider ────────────────────────────────────────────────────────
# Which embedding backend to use: openai | gemini | local
EMBEDDING_PROVIDER=openai

# Model name for embeddings
#   openai  → text-embedding-3-small, text-embedding-3-large
#   gemini  → gemini-embedding-2, gemini-embedding-001
#   local   → depends on your local server (e.g. nomic-embed-text via Ollama)
EMBEDDING_MODEL=text-embedding-3-small

# Vector dimensions — must match your vector store index
#   openai text-embedding-3-small → 1536
#   gemini-embedding-2            → 3072
#   local (nomic-embed-text)      → 768
EMBEDDING_DIMENSIONS=1536

# Only used when EMBEDDING_PROVIDER=local
# Falls back to LLM_BASE_URL if not set (handy when the same Ollama instance handles both)
# EMBEDDING_BASE_URL=http://localhost:11434/v1

# ── Vector Store ─────────────────────────────────────────────────────────────
# Which vector store to use: pinecone | chroma
VECTOR_STORE_PROVIDER=pinecone

# Pinecone (used when VECTOR_STORE_PROVIDER=pinecone)
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_NAME=wilhelm

# Chroma (used when VECTOR_STORE_PROVIDER=chroma)
# Point at a running chroma server: chroma run --path ./chroma-data
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=wilhelm

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
