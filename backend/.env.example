# Wilhelm IP Tracker and patent-document chatbot
# Copy to backend/.env and fill in local project keys.

PORT=3001
NODE_ENV=development

# Conversation model: openai | gemini | local
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key
# For Gemini instead: LLM_PROVIDER=gemini, GEMINI_API_KEY=...
# For Ollama/LM Studio instead: LLM_PROVIDER=local, LLM_BASE_URL=http://localhost:11434/v1

# Embeddings for patent documents: openai | gemini | local
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Optional local embedding endpoint; otherwise falls back to LLM_BASE_URL.
# EMBEDDING_BASE_URL=http://localhost:11434/v1
PATENT_RAG_TOP_K=5

# Supabase structured tracker read (read-only REST lookup)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_PATENT_VIEW=patents

# Supabase pgvector for indexed patent-document chunks
VECTOR_STORE_PROVIDER=supabase
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SUPABASE_TABLE=documents
SUPABASE_MATCH_FUNCTION=match_documents
SUPABASE_CLEANUP_FUNCTION=cleanup_patent_document_chunks

# Optional: used only by `npm run lookup:patent --prefix backend`.
# Set one local record identifier; don't commit confidential identifiers.
# TEST_PATENT_APPLICATION_NUMBER=
# TEST_PATENT_ID=
