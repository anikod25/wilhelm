# Wilhelm IP Tracker chatbot: Supabase records are read-only; documents use Chroma.
# Copy to backend/.env and fill in local project keys.

PORT=3001
NODE_ENV=development

# Conversation model: openai | gemini | local
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key
# For Gemini instead: LLM_PROVIDER=gemini, GEMINI_API_KEY=...
# For Ollama/LM Studio instead: LLM_PROVIDER=local, LLM_BASE_URL=http://localhost:11434/v1

# Embeddings for Chroma documents: openai | gemini | local
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Optional local embedding endpoint; otherwise falls back to LLM_BASE_URL.
# EMBEDDING_BASE_URL=http://localhost:11434/v1
PATENT_RAG_TOP_K=5

# Supabase structured tracker read (read-only REST lookup)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_PATENT_VIEW=patents

# Chroma is the only document store used by this branch.
VECTOR_STORE_PROVIDER=chroma
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=wilhelm

# Optional: used only by `npm run lookup:patent --prefix backend`.
# Set one local record identifier; don't commit confidential identifiers.
# TEST_PATENT_APPLICATION_NUMBER=
# TEST_PATENT_ID=
